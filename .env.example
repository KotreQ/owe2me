# Copy to .env and adjust. Required: MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=owe2me
MYSQL_USER=owe2me
MYSQL_PASSWORD=change-me

# Host ports
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5173

ENVIRONMENT=development
DEBUG=false
DATABASE_ECHO=false

# Auth sessions (cookie is HttpOnly; set secure=true behind HTTPS)
SESSION_COOKIE_NAME=owe2me_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Backend container runs `alembic upgrade head` on start; set false to skip
RUN_MIGRATIONS=true
