# Local (non-docker) backend settings. In docker, compose provides these.

APP_NAME=owe2me
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=mysql+pymysql://owe2me:owe2me@localhost:3306/owe2me?charset=utf8mb4
DATABASE_ECHO=false

SESSION_COOKIE_NAME=owe2me_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
